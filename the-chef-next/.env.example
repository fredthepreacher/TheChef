# Supabase project > Connect. Publishable values may appear in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Used exclusively by the public inquiry transaction.
SUPABASE_SECRET_KEY=
# Canonical origin, no trailing slash. Required for public inquiry origin validation.
APP_ORIGIN=http://localhost:3100
# Long random server-only value for hashing rate-limit identifiers.
INQUIRY_RATE_LIMIT_SECRET=
# Cloudflare Turnstile widget keys. Production intake fails closed without these.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional only for local development (ignored in production).
ALLOW_LOCAL_INQUIRIES=false

# ── Public site (launch) ──────────────────────────────────────────────────
# Canonical public origin (the purchased custom domain), no trailing slash.
# Feeds metadataBase, canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=
# Only Vercel production deployments are indexed. Set true ONLY for a
# non-Vercel production host.
SITE_INDEXABLE=false
# Ad measurement — leave EMPTY until the owner approves the privacy notice.
# Google Tag Manager container (GA4 / Google Ads / Meta Pixel are configured
# inside GTM). Unset or malformed → no tag code is rendered at all.
NEXT_PUBLIC_GTM_ID=
# Consent Mode v2 defaults: "denied" (code default), "granted", or "region"
# (owner's choice for production, Nov 9): granted globally, ad signals denied
# under Global Privacy Control, everything denied in the EEA, UK and CH.
NEXT_PUBLIC_CONSENT_DEFAULT=region
# Search Console ownership token (meta-tag method). Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── CRM Phase 3 providers. All keys below are SERVER ONLY. ────────────────
# Stripe must use test-mode values during Phase 3. A least-privilege rk_test_ key is preferred.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend requires a verified Chef-owned sending domain before delivery.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
# Owner inbox for Chef's new-inquiry alert (one per website request, queued in
# the intake transaction). Unset → no alert is queued. Needs migration
# 20261109220000_owner_inquiry_notification on the database first.
CHEF_NOTIFICATION_EMAIL=
# Protects manual/cron calls to email and automation dispatch endpoints.
CRON_SECRET=
# Vercel AI Gateway uses deployment OIDC. A static key is optional for local work.
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
